# Copy to .env (or set these in your host's dashboard). Never commit real values.

# --- Required in production ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
SITE_URL=https://locumdoc.me
# 1 when the site is served over HTTPS
SECURE_COOKIES=1
# Database and uploaded files live here; must be a persistent disk
DATA_DIR=/data

# --- First administrator (created on first boot if it doesn't exist) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Who receives "new sign-up / new application" alerts
ADMIN_NOTIFY_EMAIL=you@example.com

# --- Outgoing email: any SMTP provider (Postmark, Brevo, Amazon SES, Zoho, Google Workspace) ---
MAIL_FROM=LocumDoc <hello@locumdoc.me>
CONTACT_EMAIL=hello@locumdoc.me
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 1 for implicit TLS on port 465
SMTP_SSL=0

# --- Optional ---
MAX_UPLOAD_MB=10
# 1 adds demo hospitals, jobs and doctors (password: demo-password). Keep 0 in production.
SEED_DEMO=0
